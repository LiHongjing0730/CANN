#include <cstdint>
#include <cstdio>
#include <vector>
#include <cstdlib>
#include <cstring>
#include <random>

#include "acl/acl.h"
#include "kernel_operator.h"

#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

using namespace matmul;

constexpr int32_t M = 16;
constexpr int32_t N = 16;
constexpr int32_t K = 32;

// ---------- Host：生成Matmul Tiling ----------
bool GenerateTiling(
    platform_ascendc::PlatformAscendC* platform,
    AscendC::tiling::TCubeTiling& tiling)
{
    matmul_tiling::MultiCoreMatmulTiling config(*platform);

    config.SetDim(1);

    config.SetAType(
        matmul_tiling::TPosition::GM,
        matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT16);

    config.SetBType(
        matmul_tiling::TPosition::GM,
        matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT16);

    config.SetCType(
        matmul_tiling::TPosition::GM,
        matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);

    config.SetShape(M, N, K);
    config.SetOrgShape(M, N, K);
    config.SetFixSplit(16, 16, -1);

    // 本题没有Bias。
    config.SetBias(false);
    config.SetBufferSpace(-1, -1, -1);

    if (config.GetTiling(tiling) == -1) {
        fprintf(stderr, "GenerateTiling failed\n");
        return false;
    }

    return true;
}

// ---------- Device：Cube矩阵乘 ----------
__global__ __cube__ void cube_test_kernel(
    GM_ADDR a,
    GM_ADDR b,
    GM_ADDR c,
    GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;

    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> cGlobal;

    aGlobal.SetGlobalBuffer(
        reinterpret_cast<__gm__ half*>(a), M * K);

    bGlobal.SetGlobalBuffer(
        reinterpret_cast<__gm__ half*>(b), K * N);

    cGlobal.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(c), M * N);

    Matmul<
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
        MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>
    > mm;

    // 沿用教程的系统workspace注册方式。
    REGIST_MATMUL_OBJ(
        &pipe, GetSysWorkSpacePtr(), mm, &tiling);

    mm.SetOrgShape(M, N, K, K);
    mm.SetTensorA(aGlobal);
    mm.SetTensorB(bGlobal);

    // 完整结果写入GM，不调用SetBias。
    mm.IterateAll(cGlobal);
    mm.End();
}

// ---------- Host：错误检查和二进制输出 ----------
#define CHECK_ACL(expr)                                      \
    do {                                                     \
        aclError ret = (expr);                                \
        if (ret != ACL_SUCCESS) {                            \
            fprintf(stderr, "%s failed: %d\n",                \
                    #expr, static_cast<int>(ret));             \
            return 1;                                        \
        }                                                    \
    } while (0)

bool SaveBinary(const char* path, const void* data, size_t bytes)
{
    FILE* file = fopen(path, "wb");
    if (!file) {
        perror(path);
        return false;
    }

    const size_t written = fwrite(data, 1, bytes, file);
    const int closeRet = fclose(file);

    return written == bytes && closeRet == 0;
}

// ---------- Host：本地独立测试入口 ----------
class VectorMaxSum {
public:
    __aicore__ inline void Init(GM_ADDR c, GM_ADDR y)
    {
        cGlobal.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(c), M * N);
        yGlobal.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(y), 1);

        // 输入矩阵：16 × 16 × 4 = 1024字节。
        pipe.InitBuffer(inQueue, 1, M * N * sizeof(float));

        // 输出UB预留32字节，但GM只写一个float。
        pipe.InitBuffer(outQueue, 1, 32);

        // 每个行最大值占一个32字节槽位，保证地址对齐。
        pipe.InitBuffer(rowMaxBuffer, M * 32);

        // 连续排列的16个行最大值。
        pipe.InitBuffer(packedBuffer, M * sizeof(float));

        // 归约工作区，本测试预留256字节。
        pipe.InitBuffer(workBuffer, 256);
    }

    __aicore__ inline void Process()
    {
        // GM -> UB。当前整个矩阵大小满足32字节对齐。
        auto input = inQueue.AllocTensor<float>();
        AscendC::DataCopy(input, cGlobal, M * N);
        inQueue.EnQue(input);
        input = inQueue.DeQue<float>();

        auto rowMax = rowMaxBuffer.Get<float>();
        auto packed = packedBuffer.Get<float>();
        auto work = workBuffer.Get<float>();

        // 先沿N维取最大值。
        // 每行16个float，共64字节，行起始地址满足对齐。
        for (int32_t m = 0; m < M; ++m) {
            AscendC::ReduceMax<float>(
                rowMax[m * 8], input[m * N], work, N, false);

            // 下一行复用工作区前，等待前一次Vector操作。
            AscendC::PipeBarrier<PIPE_V>();
        }

        // Vector写入完成后，才能通过标量读取UB。
        auto vsEvent =
            pipe.FetchEventID(AscendC::HardEvent::V_S);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(vsEvent);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(vsEvent);

        // 去掉行最大值之间的对齐空隙。
        for (int32_t m = 0; m < M; ++m) {
            packed.SetValue(m, rowMax.GetValue(m * 8));
        }

        // 标量写入完成后，才能让Vector读取packed。
        auto svEvent =
            pipe.FetchEventID(AscendC::HardEvent::S_V);
        AscendC::SetFlag<AscendC::HardEvent::S_V>(svEvent);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(svEvent);

        // 再沿M维求和。
        auto output = outQueue.AllocTensor<float>();
        AscendC::ReduceSum<float>(output, packed, work, M);

        outQueue.EnQue(output);
        output = outQueue.DeQue<float>();

        // 只写4字节，避免向仅分配一个float的GM写32字节。
        AscendC::DataCopyExtParams copyParams{};
        copyParams.blockCount = 1;
        copyParams.blockLen = sizeof(float);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;

        AscendC::DataCopyPad(yGlobal, output, copyParams);

        outQueue.FreeTensor(output);
        inQueue.FreeTensor(input);
    }

private:
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> cGlobal;
    AscendC::GlobalTensor<float> yGlobal;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;

    AscendC::TBuf<AscendC::QuePosition::VECCALC> rowMaxBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> packedBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> workBuffer;
};

__global__ __vector__ void vector_max_sum_kernel(
    GM_ADDR c, GM_ADDR y)
{
    VectorMaxSum op;
    op.Init(c, y);
    op.Process();
}
int main(int argc, char** argv)
{
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    uint8_t* yDevice = nullptr;
    float yHost = 0.0f;

    CHECK_ACL(aclrtMalloc(
    reinterpret_cast<void**>(&yDevice),
    sizeof(float),
    ACL_MEM_MALLOC_HUGE_FIRST));

    auto* platform =
        platform_ascendc::PlatformAscendCManager::GetInstance();

    if (!platform) {
        fprintf(stderr, "Cannot get platform information\n");
        return 1;
    }

    AscendC::tiling::TCubeTiling tiling{};
    if (!GenerateTiling(platform, tiling)) {
        return 1;
    }

    std::vector<aclFloat16> a(M * K);
    std::vector<aclFloat16> b(K * N);
    std::vector<float> c(M * N);

    // 使用可精确表示的正负数，避免只测全1矩阵。
    const char* mode = argc > 1 ? argv[1] : "original";
const unsigned seed = argc > 2
    ? static_cast<unsigned>(std::strtoul(argv[2], nullptr, 10))
    : 2026u;

if (std::strcmp(mode, "negative") == 0) {
    // A全部为1。
    for (int i = 0; i < M * K; ++i) {
        a[i] = aclFloatToFloat16(1.0f);
    }

    // 每列使用不同的负数，且最大值位于最后一列。
    // C[m,n] = -(N-n)，每行最大值为-1。
    for (int k = 0; k < K; ++k) {
        for (int n = 0; n < N; ++n) {
            float value = -static_cast<float>(N - n) / K;
            b[k * N + n] = aclFloatToFloat16(value);
        }
    }
} else if (std::strcmp(mode, "zero") == 0) {
    for (int i = 0; i < M * K; ++i) {
        a[i] = aclFloatToFloat16(0.0f);
    }
    for (int i = 0; i < K * N; ++i) {
        b[i] = aclFloatToFloat16(0.0f);
    }
} else if (std::strcmp(mode, "random") == 0) {
    std::mt19937 rng(seed);

    // 使用FP16可精确表示的数，先集中验证计算与归约逻辑。
    std::uniform_int_distribution<int> dist(-8, 8);

    for (int i = 0; i < M * K; ++i) {
        a[i] = aclFloatToFloat16(dist(rng) * 0.125f);
    }
    for (int i = 0; i < K * N; ++i) {
        b[i] = aclFloatToFloat16(dist(rng) * 0.125f);
    }
    } else if (std::strcmp(mode, "original") == 0) {
    for (int i = 0; i < M * K; ++i) {
        a[i] = aclFloatToFloat16((i % 13 - 6) * 0.125f);
    }
    for (int i = 0; i < K * N; ++i) {
        b[i] = aclFloatToFloat16((i % 11 - 5) * 0.125f);
    }
    } else {
    fprintf(stderr, "Unknown test mode: %s\n", mode);
    return 1;
    }

fprintf(stderr, "[case] mode=%s seed=%u\n", mode, seed);

    const size_t aBytes = a.size() * sizeof(aclFloat16);
    const size_t bBytes = b.size() * sizeof(aclFloat16);
    const size_t cBytes = c.size() * sizeof(float);

    size_t workspaceBytes = platform->GetLibApiWorkSpaceSize();
    if (workspaceBytes == 0) {
        workspaceBytes = 32;
    }

    uint8_t* aDevice = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* cDevice = nullptr;
    uint8_t* workspaceDevice = nullptr;

    CHECK_ACL(aclrtMalloc(
        reinterpret_cast<void**>(&aDevice),
        aBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    CHECK_ACL(aclrtMalloc(
        reinterpret_cast<void**>(&bDevice),
        bBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    CHECK_ACL(aclrtMalloc(
        reinterpret_cast<void**>(&cDevice),
        cBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    CHECK_ACL(aclrtMalloc(
        reinterpret_cast<void**>(&workspaceDevice),
        workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    CHECK_ACL(aclrtMemcpy(
        aDevice, aBytes, a.data(), aBytes,
        ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMemcpy(
        bDevice, bBytes, b.data(), bBytes,
        ACL_MEMCPY_HOST_TO_DEVICE));

    cube_test_kernel<<<1, nullptr, stream>>>(
    aDevice, bDevice, cDevice, workspaceDevice, tiling);

// 使用同一个stream，Vector读取前一个Kernel产生的C。
    vector_max_sum_kernel<<<1, nullptr, stream>>>(
    cDevice, yDevice);

    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(
    &yHost,
    sizeof(float),
    yDevice,
    sizeof(float),
    ACL_MEMCPY_DEVICE_TO_HOST));

if (!SaveBinary("cube_y.bin", &yHost, sizeof(float))) {
    fprintf(stderr, "Failed to save cube_y.bin\n");
    return 1;
}

fprintf(stderr, "Vector MaxSum output: %.9g\n", yHost);

    CHECK_ACL(aclrtMemcpy(
        c.data(), cBytes, cDevice, cBytes,
        ACL_MEMCPY_DEVICE_TO_HOST));

    // 单独命名，不覆盖现有算子测试文件。
    if (!SaveBinary("cube_a.bin", a.data(), aBytes) ||
        !SaveBinary("cube_b.bin", b.data(), bBytes) ||
        !SaveBinary("cube_c.bin", c.data(), cBytes)) {
        return 1;
    }

    fprintf(stderr, "Cube output saved: 16 x 16 FP32\n");
    fflush(stderr);

    CHECK_ACL(aclrtFree(aDevice));
    CHECK_ACL(aclrtFree(bDevice));
    CHECK_ACL(aclrtFree(cDevice));
    CHECK_ACL(aclrtFree(workspaceDevice));
    CHECK_ACL(aclrtFree(yDevice));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());

    return 0;
}
