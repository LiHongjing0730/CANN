#include <cstdint>
#include <cstdio>
#include "kernel_operator.h"
#include <cstdlib>
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
namespace bmms {
struct Shape { uint32_t b,m,n,k,dtype,tx1,tx2; };
inline bool Parse(const TensorGroupInfo& ga,const TensorGroupInfo& gb,const TensorGroupInfo& gy,bool ta,bool tb,Shape& s) {
 if(ga.numTensors!=1||gb.numTensors!=1||gy.numTensors!=1||!ga.tensors||!gb.tensors||!gy.tensors)return false;
 const auto& a=ga.tensors[0];const auto& b=gb.tensors[0];const auto& y=gy.tensors[0];
 if(!a.shape||!b.shape||!y.shape||a.numDims!=3||b.numDims!=3||y.numDims!=1)return false;
 if(a.dtype!=b.dtype||(a.dtype!=1&&a.dtype!=2)||y.dtype!=0)return false;
 int64_t B=a.shape[0],M=a.shape[ta?2:1],K=a.shape[ta?1:2],N=b.shape[tb?1:2];
 if(B!=b.shape[0]||K!=b.shape[tb?2:1]||y.shape[0]!=B)return false;
 if(B<1||B>64||M<1||M>8192||N<1||N>8192||K<32||K>8192||K%8)return false;
 if(B*M*K>(int64_t{1}<<26)||B*N*K>(int64_t{1}<<26))return false;
 s={uint32_t(B),uint32_t(M),uint32_t(N),uint32_t(K),uint32_t(a.dtype),uint32_t(ta),uint32_t(tb)};return true;
}
__aicore__ inline float Decode(uint16_t raw,uint32_t dtype) {
 union Bits{uint32_t u;float f;}v;
 if(dtype==2){v.u=uint32_t(raw)<<16;return v.f;}
 uint32_t sign=(uint32_t(raw)&0x8000u)<<16,exp=(raw>>10)&31u,frac=raw&1023u;
 if(exp==0){
  if(frac==0){v.u=sign;return v.f;}
  int32_t e=-14;while((frac&1024u)==0){frac<<=1;--e;}
  v.u=sign|(uint32_t(e+127)<<23)|((frac&1023u)<<13);
 }else if(exp==31){v.u=sign|0x7f800000u|(frac<<13);}
 else{v.u=sign|((exp+112u)<<23)|(frac<<13);}return v.f;
}
__aicore__ inline void Accumulate(float value,float& sum,float& correction){
 float adjusted=value-correction;float next=sum+adjusted;
 correction=(next-sum)-adjusted;sum=next;
}
}
// Single-core scalar correctness baseline, not a performance kernel.
__global__ __vector__ void batch_matmul_max_sum_custom(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,bmms::Shape s){
 AscendC::GlobalTensor<uint16_t>a,b;AscendC::GlobalTensor<float>out;
 a.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1),uint64_t(s.b)*s.m*s.k);
 b.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2),uint64_t(s.b)*s.k*s.n);
 out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),s.b);
 for(uint32_t batch=0;batch<s.b;++batch){
  uint64_t aBase=uint64_t(batch)*s.m*s.k,bBase=uint64_t(batch)*s.k*s.n;
  float total=0,totalCorrection=0;
  for(uint32_t m=0;m<s.m;++m){
   float rowMax=0;
   for(uint32_t n=0;n<s.n;++n){
    float dot=0,dotCorrection=0;
    for(uint32_t k=0;k<s.k;++k){
     uint64_t ai=aBase+(s.tx1?uint64_t(k)*s.m+m:uint64_t(m)*s.k+k);
     uint64_t bi=bBase+(s.tx2?uint64_t(n)*s.k+k:uint64_t(k)*s.n+n);
     float av=bmms::Decode(a.GetValue(ai),s.dtype),bv=bmms::Decode(b.GetValue(bi),s.dtype);
     bmms::Accumulate(av*bv,dot,dotCorrection);
    }
    if(n==0||dot>rowMax)rowMax=dot;
   }
   bmms::Accumulate(rowMax,total,totalCorrection);
  }
  out.SetValue(batch,total);
 }
}
// Stage 1 integration: aligned FP16 scratch, one Cube launch per batch.
// The pack kernel copies raw bits; it does not change or normalize inputs.
__global__ __vector__ void bmms_pack_inputs(GM_ADDR x1, GM_ADDR x2,
    GM_ADDR ap, GM_ADDR bp, bmms::Shape s, uint32_t mp, uint32_t np, uint32_t kp) {
    AscendC::GlobalTensor<uint16_t> a,b,pa,pb;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x1), uint64_t(s.b)*s.m*s.k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(x2), uint64_t(s.b)*s.k*s.n);
    pa.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(ap), uint64_t(s.b)*mp*kp);
    pb.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(bp), uint64_t(s.b)*kp*np);
    for(uint32_t batch=0;batch<s.b;++batch) {
        for(uint32_t m=0;m<mp;++m) for(uint32_t k=0;k<kp;++k)
            pa.SetValue((uint64_t(batch)*mp+m)*kp+k,
                m<s.m && k<s.k ? a.GetValue(uint64_t(batch)*s.m*s.k+(s.tx1 ? uint64_t(k)*s.m+m : uint64_t(m)*s.k+k)) : uint16_t(0));
        for(uint32_t k=0;k<kp;++k) for(uint32_t n=0;n<np;++n)
            pb.SetValue((uint64_t(batch)*kp+k)*np+n,
                k<s.k && n<s.n ? b.GetValue(uint64_t(batch)*s.k*s.n+(s.tx2 ? uint64_t(n)*s.k+k : uint64_t(k)*s.n+n)) : uint16_t(0));
    }
}

template<typename InputT>
__global__ __cube__ void bmms_cube_typed(GM_ADDR a, GM_ADDR b, GM_ADDR c,
    GM_ADDR workspace, AscendC::tiling::TCubeTiling tiling,
    uint32_t mp, uint32_t np, uint32_t kp) {
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<InputT> ga,gb;
    AscendC::GlobalTensor<float> gc;
    ga.SetGlobalBuffer(reinterpret_cast<__gm__ InputT*>(a),uint64_t(mp)*kp);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ InputT*>(b),uint64_t(kp)*np);
    gc.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c),uint64_t(mp)*np);
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,InputT>,
        matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,InputT>,
        matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>,
        matmul::MatmulType<AscendC::TPosition::GM,CubeFormat::ND,float>> mm;
    REGIST_MATMUL_OBJ(&pipe,GetSysWorkSpacePtr(),mm,&tiling);
    mm.SetOrgShape(mp,np,kp,kp);
    mm.SetTensorA(ga);
    mm.SetTensorB(gb);
    mm.IterateAll(gc);
    mm.End();
}

class BmmsVectorRows {
public:
    __aicore__ inline void Init(GM_ADDR c,GM_ADDR y,bmms::Shape shape,
        uint32_t mp,uint32_t np) {
        s=shape; paddedM=mp; paddedN=np;
        gc.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c),uint64_t(s.b)*mp*np);
        gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),s.b);
        pipe.InitBuffer(inQ,1,np*sizeof(float));
        pipe.InitBuffer(outQ,1,32);
        pipe.InitBuffer(maxBuf,32);
        pipe.InitBuffer(packedBuf,((s.m+7)/8)*32);
        pipe.InitBuffer(workBuf,4096);
    }
    __aicore__ inline void Process() {
        auto rowMax=maxBuf.Get<float>();
        auto packed=packedBuf.Get<float>();
        auto work=workBuf.Get<float>();
        for(uint32_t batch=0;batch<s.b;++batch) {
            for(uint32_t m=0;m<s.m;++m) {
                auto row=inQ.AllocTensor<float>();
                // Read the aligned physical row; reduce only its actual N values.
                AscendC::DataCopy(row,gc[(uint64_t(batch)*paddedM+m)*paddedN],paddedN);
                inQ.EnQue(row);
                row=inQ.DeQue<float>();
                AscendC::ReduceMax<float>(rowMax,row,work,s.n,false);
                auto vs=pipe.FetchEventID(AscendC::HardEvent::V_S);
                AscendC::SetFlag<AscendC::HardEvent::V_S>(vs);
                AscendC::WaitFlag<AscendC::HardEvent::V_S>(vs);
                packed.SetValue(m,rowMax.GetValue(0));
                inQ.FreeTensor(row);
            }
            auto sv=pipe.FetchEventID(AscendC::HardEvent::S_V);
            AscendC::SetFlag<AscendC::HardEvent::S_V>(sv);
            AscendC::WaitFlag<AscendC::HardEvent::S_V>(sv);
            auto result=outQ.AllocTensor<float>();
            AscendC::ReduceSum<float>(result,packed,work,s.m);
            outQ.EnQue(result);
            result=outQ.DeQue<float>();
            AscendC::DataCopyExtParams params{};
            params.blockCount=1;params.blockLen=sizeof(float);
            AscendC::DataCopyPad(gy[batch],result,params);
            outQ.FreeTensor(result);
            // Ensure packed/work UB can be reused for the next batch.
            auto vs=pipe.FetchEventID(AscendC::HardEvent::V_S);
            AscendC::SetFlag<AscendC::HardEvent::V_S>(vs);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(vs);
        }
    }
private:
    bmms::Shape s{};
    uint32_t paddedM=0,paddedN=0;
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> gc,gy;
    AscendC::TQue<AscendC::QuePosition::VECIN,1> inQ;
    AscendC::TQue<AscendC::QuePosition::VECOUT,1> outQ;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> maxBuf,packedBuf,workBuf;
};
__global__ __vector__ void bmms_vector_rows(GM_ADDR c,GM_ADDR y,bmms::Shape s,
    uint32_t mp,uint32_t np) {
    BmmsVectorRows op;op.Init(c,y,s,mp,np);op.Process();
}

namespace bmms {
inline void CheckRuntime(aclError ret,const char* operation) {
    if(ret!=ACL_SUCCESS) {
        std::fprintf(stderr,"[BMMS] %s failed: %d\n",operation,int(ret));
        std::abort(); // Do not let the host save an uninitialized output.
    }
}
inline bool MakeCubeTiling(platform_ascendc::PlatformAscendC* platform,
    uint32_t mp,uint32_t np,uint32_t kp,uint32_t dtype,AscendC::tiling::TCubeTiling& tiling) {
    matmul_tiling::MultiCoreMatmulTiling cfg(*platform);
    cfg.SetDim(1);
    const auto inputType=dtype==1 ? matmul_tiling::DataType::DT_FLOAT16
        : matmul_tiling::DataType::DT_BFLOAT16;
    cfg.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
        inputType);
    cfg.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
        inputType);
    cfg.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);
    cfg.SetShape(mp,np,kp);cfg.SetOrgShape(mp,np,kp);
    cfg.SetFixSplit(16,16,-1);cfg.SetBias(false);cfg.SetBufferSpace(-1,-1,-1);
    return cfg.GetTiling(tiling)!=-1;
}
}

extern "C" void run_kernel(GM_ADDR x1,const TensorGroupInfo& info_x1,
    GM_ADDR x2,const TensorGroupInfo& info_x2,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream,bool transposeX1,bool transposeX2) {
    bmms::Shape s{};
    if(!x1||!x2||!y||availableCoreNum<=0||
       !bmms::Parse(info_x1,info_x2,info_y,transposeX1,transposeX2,s)) {
        std::fprintf(stderr,"[BMMS] Invalid metadata or pointers\n");std::abort();
    }
    uint32_t mp=(s.m+15)/16*16,np=(s.n+15)/16*16,kp=(s.k+15)/16*16;
    uint64_t packedCount=uint64_t(s.b)*(uint64_t(mp)*kp+uint64_t(kp)*np);
    uint64_t cBytes=uint64_t(s.b)*mp*np*sizeof(float);
    const char* force=std::getenv("BMMS_FORCE_SCALAR");
    // Debug rollout limits: avoid huge full-matrix scratch and slow scalar packing.
    bool cube=(s.dtype==1 || s.dtype==2) &&
        packedCount<=(uint64_t(1)<<20) && cBytes<=(uint64_t(64)<<20) &&
        !(force && force[0]=='1');
    if(!cube) {
        std::fprintf(stderr,"[BMMS] path=scalar B=%u M=%u N=%u K=%u dtype=%u tx=%u,%u\n",
            s.b,s.m,s.n,s.k,s.dtype,s.tx1,s.tx2);
        batch_matmul_max_sum_custom<<<1,nullptr,stream>>>(x1,x2,y,s);
        return;
    }
    auto* platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    AscendC::tiling::TCubeTiling tiling{};
    if(!platform||!bmms::MakeCubeTiling(platform,mp,np,kp,s.dtype,tiling)) {
        std::fprintf(stderr,"[BMMS] Cube tiling failed; no output produced\n");std::abort();
    }
    std::fprintf(stderr,"[BMMS] path=cube_vector B=%u logical=%u,%u,%u padded=%u,%u,%u dtype=%u tx=%u,%u\n",
        s.b,s.m,s.n,s.k,mp,np,kp,s.dtype,s.tx1,s.tx2);
    uint8_t *pa=nullptr,*pb=nullptr,*pc=nullptr,*ws=nullptr;
    size_t aBytes=size_t(s.b)*mp*kp*2,bBytes=size_t(s.b)*kp*np*2;
    size_t wsBytes=platform->GetLibApiWorkSpaceSize();if(wsBytes==0)wsBytes=32;
    bmms::CheckRuntime(aclrtMalloc((void**)&pa,aBytes,ACL_MEM_MALLOC_HUGE_FIRST),"allocate A scratch");
    bmms::CheckRuntime(aclrtMalloc((void**)&pb,bBytes,ACL_MEM_MALLOC_HUGE_FIRST),"allocate B scratch");
    bmms::CheckRuntime(aclrtMalloc((void**)&pc,size_t(cBytes),ACL_MEM_MALLOC_HUGE_FIRST),"allocate C scratch");
    bmms::CheckRuntime(aclrtMalloc((void**)&ws,wsBytes,ACL_MEM_MALLOC_HUGE_FIRST),"allocate workspace");
    bmms_pack_inputs<<<1,nullptr,stream>>>((GM_ADDR)x1,(GM_ADDR)x2,(GM_ADDR)pa,(GM_ADDR)pb,s,mp,np,kp);
    for(uint32_t batch=0;batch<s.b;++batch) {
        if(s.dtype==1) {
        bmms_cube_typed<half><<<1,nullptr,stream>>>(
            (GM_ADDR)(pa+size_t(batch)*mp*kp*2),
            (GM_ADDR)(pb+size_t(batch)*kp*np*2),
            (GM_ADDR)(pc+size_t(batch)*mp*np*4),
            (GM_ADDR)ws,tiling,mp,np,kp);
        } else {
        bmms_cube_typed<bfloat16_t><<<1,nullptr,stream>>>(
            (GM_ADDR)(pa+size_t(batch)*mp*kp*2),
            (GM_ADDR)(pb+size_t(batch)*kp*np*2),
            (GM_ADDR)(pc+size_t(batch)*mp*np*4),
            (GM_ADDR)ws,tiling,mp,np,kp);
        }
    }
    bmms_vector_rows<<<1,nullptr,stream>>>((GM_ADDR)pc,y,s,mp,np);
    // Scratch must remain alive until all stream operations finish.
    bmms::CheckRuntime(aclrtSynchronizeStream(stream),"synchronize scratch users");
    bmms::CheckRuntime(aclrtFree(pa),"free A scratch");
    bmms::CheckRuntime(aclrtFree(pb),"free B scratch");
    bmms::CheckRuntime(aclrtFree(pc),"free C scratch");
    bmms::CheckRuntime(aclrtFree(ws),"free workspace");
}
