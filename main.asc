// Local test main — runs the first test case
// Usage: ./batch_matmul_max_sum_custom

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

int main(int argc, char** argv)
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t B=1,M=1,N=1,K=32;
    int32_t dtype=1;
    bool transposeX1=false,transposeX2=false;
    if(argc!=1&&argc!=8){fprintf(stderr,"Usage: %s [B M N K dtype tx1 tx2]\n",argv[0]);return 1;}
    if(argc==8){
        B=std::strtoll(argv[1],nullptr,10);M=std::strtoll(argv[2],nullptr,10);
        N=std::strtoll(argv[3],nullptr,10);K=std::strtoll(argv[4],nullptr,10);
        dtype=std::atoi(argv[5]);int ta=std::atoi(argv[6]),tb=std::atoi(argv[7]);
        if((ta!=0&&ta!=1)||(tb!=0&&tb!=1))return 1;
        transposeX1=ta!=0;transposeX2=tb!=0;
    }
    int64_t x1_0_shape[]={B,transposeX1?K:M,transposeX1?M:K};
    int64_t x2_0_shape[]={B,transposeX2?N:K,transposeX2?K:N};
    int64_t y_0_shape[]={B};
    TensorInfo x1_tensors[]={{x1_0_shape,3,dtype}},x2_tensors[]={{x2_0_shape,3,dtype}},y_tensors[]={{y_0_shape,1,0}};
    TensorGroupInfo info_x1={x1_tensors,1},info_x2={x2_tensors,1},info_y={y_tensors,1};
    bmms::Shape shape{};
    if(!bmms::Parse(info_x1,info_x2,info_y,transposeX1,transposeX2,shape)){
        fprintf(stderr,"Invalid shape/dtype/attributes\n");return 1;
    }
    const size_t bytes_x1=static_cast<size_t>(B*M*K)*2;
    const size_t bytes_x2=static_cast<size_t>(B*N*K)*2;
    const size_t bytes_y=static_cast<size_t>(B)*4;

    uint8_t *inputHost_x1 = nullptr, *inputDevice_x1 = nullptr;
    uint8_t *inputHost_x2 = nullptr, *inputDevice_x2 = nullptr;

    uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x1, bytes_x1));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x1, bytes_x1, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x1.bin", bytes_x1, inputHost_x1, bytes_x1));
    ACL_CHECK(aclrtMemcpy(inputDevice_x1, bytes_x1, inputHost_x1, bytes_x1, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x2, bytes_x2));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x2, bytes_x2, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x2.bin", bytes_x2, inputHost_x2, bytes_x2));
    ACL_CHECK(aclrtMemcpy(inputDevice_x2, bytes_x2, inputHost_x2, bytes_x2, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_y, bytes_y));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_y, bytes_y, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_x1, info_x1, (GM_ADDR)inputDevice_x2, info_x2, (GM_ADDR)outputDevice_y, info_y, availableCoreNum, stream, transposeX1, transposeX2);
    auto sync_ret_ = aclrtSynchronizeStream(stream);
    if (sync_ret_ != 0) { fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_); return 1; }

    ACL_CHECK(aclrtMemcpy(outputHost_y, bytes_y, outputDevice_y, bytes_y, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/y.bin", outputHost_y, bytes_y));
// stderr日志用于确认哪个清理调用没有返回。
#define CLEANUP_STEP(expr)                                      \
    do {                                                        \
        fprintf(stderr, "[cleanup] BEGIN %s\n", #expr);          \
        fflush(stderr);                                         \
        aclError ret = (expr);                                   \
        fprintf(stderr, "[cleanup] END %s ret=%d\n",             \
                #expr, static_cast<int>(ret));                   \
        fflush(stderr);                                         \
        if (ret != ACL_SUCCESS) return 1;                        \
    } while (0)

if (inputDevice_x1) CLEANUP_STEP(aclrtFree(inputDevice_x1));
if (inputHost_x1)   CLEANUP_STEP(aclrtFreeHost(inputHost_x1));
if (inputDevice_x2) CLEANUP_STEP(aclrtFree(inputDevice_x2));
if (inputHost_x2)   CLEANUP_STEP(aclrtFreeHost(inputHost_x2));
if (outputDevice_y) CLEANUP_STEP(aclrtFree(outputDevice_y));
if (outputHost_y)   CLEANUP_STEP(aclrtFreeHost(outputHost_y));

CLEANUP_STEP(aclrtDestroyStream(stream));
CLEANUP_STEP(aclrtResetDevice(deviceId));
CLEANUP_STEP(aclFinalize());

fprintf(stderr, "[cleanup] main returning\n");
fflush(stderr);

#undef CLEANUP_STEP
    return 0;
}
